{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docklet",
  "version": "0.1.0",
  "identifier": "com.subho.docklet",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/docklet/browser"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Docklet Quick Panel",
        "width": 380,
        "height": 410,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "main",
        "title": "Docklet",
        "width": 900,
        "height": 620,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
